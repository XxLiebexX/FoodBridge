# ==========================================
# FOODBRIDGE AI - ENVIRONMENT CONFIGURATION
# ==========================================

# Port Configuration
PORT=5001
WEB_PORT=3000
ML_PORT=8001

# API & Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:5001/api
ML_SERVICE_URL=http://localhost:8001
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL default, SQLite fallback supported)
DATABASE_URL="file:./dev.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://foodbridge_user:foodbridge_pass@localhost:5432/foodbridge_db?schema=public"

# Authentication Secrets (Replace in production)
JWT_ACCESS_SECRET="foodbridge_super_secure_access_secret_2026_dev_key"
JWT_REFRESH_SECRET="foodbridge_super_secure_refresh_secret_2026_dev_key"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Node Environment
NODE_ENV="development"
